# Copy to .env and adjust for your machine:
#   cp .env.example .env

# Network: nile | mainnet
NETWORK=nile

# java-tron release tag (downloaded at build time) and the SHA-256 of its FullNode jar.
# Both come from the release page; the build fails if they do not match. The jar's GPG
# signature is checked as well (keys/). Bump the two values together on every upgrade.
# Nile:    https://github.com/tron-nile-testnet/nile-testnet/releases   (FullNode-Nile-x64-*.jar)
# Mainnet: https://github.com/tronprotocol/java-tron/releases           (FullNode.jar)
JAVA_TRON_VERSION=GreatVoyage-Nile-v4.8.2.4-PQ1-build1
FULLNODE_SHA256=b62fb08e647b1336749a2da1bfa37447377e26c80fd85540fabea5b2de23dc41
# Mainnet example:
# JAVA_TRON_VERSION=GreatVoyage-v4.8.2.4
# FULLNODE_SHA256=709423e8d14ccba391daeef7aa78bb5f41a1b69559cc867346beacbd6aae39c9

# JVM / container memory
JVM_HEAP_GB=24
MEM_LIMIT=32g

# Docker container names (docker ps / docker exec)
KAFKA_CONTAINER_NAME=kafka
TRON_CONTAINER_NAME=tron-node

# Docker bridge network shared by kafka + tron (and other stacks on the same host)
DOCKER_NETWORK_NAME=tronsave

# Host paths bind-mounted into containers (absolute paths recommended on Linux servers)
# Tron: folder must contain database/ and index/ (java-tron output-directory layout)
TRON_DATA_PATH=./data/tron
# Kafka: broker log directory
KAFKA_DATA_PATH=./data/kafka

# Example — reuse an existing snapshot / node data:
# TRON_DATA_PATH=/home/user/tron/output-directory
# KAFKA_DATA_PATH=/home/user/kafka-data

# Service ports (host = container)
HTTP_PORT=8090
GRPC_PORT=50051
JSONRPC_PORT=8545
P2P_PORT=18888
PROMETHEUS_PORT=9527

# Host address the API ports (HTTP, JSON-RPC, gRPC, Prometheus) are published on.
# These APIs have no authentication. Use 127.0.0.1 for local-only access or a private
# interface address; keep 0.0.0.0 only behind a firewall. P2P is always published on all interfaces.
API_BIND_IP=0.0.0.0

# Optional endpoints: turn off what you do not use.
JSONRPC_ENABLED=true
PROMETHEUS_ENABLED=true

# Healthcheck: unhealthy when the head block is older than this many seconds (0 = only check that the API answers)
HEALTH_MAX_LAG_SEC=300

# Optional: max TVM execution time (ms) for constant calls (triggerconstantcontract, eth_call, ...).
# Empty = java-tron default.
CONSTANT_CALL_TIMEOUT_MS=

# Kafka: KAFKA_PORT = host access, KAFKA_INTERNAL_PORT = tron -> kafka inside Docker network
# KAFKA_CONTROLLER_PORT must differ from KAFKA_PORT (KRaft controller listener)
KAFKA_PORT=9092
KAFKA_INTERNAL_PORT=19092
KAFKA_CONTROLLER_PORT=9093
KAFKA_ADVERTISED_HOST=localhost
# Host address the Kafka EXTERNAL listener is published on (PLAINTEXT, no authentication)
KAFKA_BIND_IP=0.0.0.0
# Broker image tag (apache/kafka)
KAFKA_VERSION=3.9.2

# Message retention (default: 7 days)
KAFKA_LOG_RETENTION_MS=604800000
# Optional size cap per partition in bytes (-1 = no size cap)
KAFKA_LOG_RETENTION_BYTES=-1

# Container log rotation (docker json-file)
LOG_MAX_SIZE=50m
LOG_MAX_FILE=5

# Kafka event plugin (event.subscribe.enable)
EVENT_PLUGIN_ENABLED=true
EVENT_START_SYNC_BLOCK_NUM=0

# Triggers pushed to Kafka (comma-separated). Each one costs CPU on the node and disk on the
# broker, so list only what your consumers read.
# Available: block, transaction, contractevent, contractlog, solidity, solidityevent, soliditylog
EVENT_TOPICS=block,transaction,contractevent,contractlog

# Event filters (comma-separated lists). Leave empty to subscribe to ALL events.
# EVENT_CONTRACT_ADDRESS: only emit events from these contract addresses (base58).
# EVENT_CONTRACT_TOPIC:   only emit events matching these topic hashes.
# Example: EVENT_CONTRACT_ADDRESS=TXYZ...,TABC...
EVENT_CONTRACT_ADDRESS=
EVENT_CONTRACT_TOPIC=

# Lite FullNode: set LITE_NODE=true and put a lite snapshot under TRON_DATA_PATH (see README)
LITE_NODE=false
LITE_OPEN_HISTORY=false
